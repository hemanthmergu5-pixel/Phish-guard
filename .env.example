DB_PATH=./backend/database/phishguard.db
TRUST_PROXY=false

# Admin dashboard
ADMIN_EMAIL=admin@phishguard.local
ADMIN_PASSWORD=CHANGE_THIS_TO_A_LONG_RANDOM_PASSWORD
ADMIN_NAME=PhishGuard Administrator

